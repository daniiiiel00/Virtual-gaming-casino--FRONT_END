{
  "name": "@gaming-platform/monorepo",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @gaming-platform/user-app dev",
    "dev:user": "pnpm --filter @gaming-platform/user-app dev",
    "build:user": "pnpm --filter @gaming-platform/user-app build",
    "build": "pnpm run build:user && cp -r apps/user-app/dist dist",
    "lint": "pnpm -r lint"
  }
}
